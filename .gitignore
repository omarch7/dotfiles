lazy-lock.json
tmux/.tmux/plugins/
!claude/.claude/
.graphify_python
graphify-out/cache/
.superpowers/
herdr/.config/herdr/*.log
herdr/.config/herdr/session.json
herdr/.config/herdr/release-notes.json
herdr/.config/herdr/.plugins.lock
claude/.claude/hooks/herdr-agent-state.sh
# On Linux, stow folding plus glow's habit of auto-creating a default config
# would drop glow.yml inside this package; the theme script owns that file.
glow/.config/glow/glow.yml
# Generated by the theme script (stable-slug catppuccin palette swap); also
# lands here on a fresh machine if stow folds ~/.claude/themes into the repo.
claude/.claude/themes/catppuccin.json
